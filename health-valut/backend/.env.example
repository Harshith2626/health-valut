# PostgreSQL connection string. Use Render Postgres, Supabase, or Neon for a free hosted DB.
DATABASE_URL="postgresql://user:password@localhost:5432/health_valut?schema=public"

# Long random string used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (your Vercel URL + localhost)
CORS_ORIGIN="http://localhost:5173"

# Optional: enables real AI Assistant / Report Explainer / Prescription Analyzer / Health Summary
# responses via the Anthropic API. Without it, the AI routes return clearly-labeled demo responses
# so the app is fully runnable out of the box.
ANTHROPIC_API_KEY=""
